; Advertise a service with a readable value of 42.

(def service-uuid [
    0xad 0x2d 0x03 0xdb 0x53 0x35 0x43 0xaf
    0x9a 0x70 0xea 0x54 0x63 0xad 0x38 0x13
])
(def chr-uuid [
    0xae 0x2d 0x03 0xdb 0x53 0x35 0x43 0xaf
    0x9a 0x70 0xea 0x54 0x63 0xad 0x38 0x13
])
(def name "device-name")
(def name-bytes (buf-resize name -1 'copy))

(def adv-data '(
    (flags . [0x06])
    (conn-interval-range . [0x06 0x00 0x30 0x00])
    (incomplete-uuid-128 . [
        0x13 0x38 0xad 0x63 0x54 0xea 0x70 0x9a
        0xaf 0x43 0x35 0x53 0xdb 0x03 0x2d 0xad
    ])
))
(def scan-rsp-data `(
    (name-complete . ,name-bytes)
))

(ble-set-name name)
(ble-conf-adv t adv-data scan-rsp-data)
(ble-start-app)
(map ble-remove-service (reverse (ble-get-services)))

(def handles (ble-add-service service-uuid `(
    (
        (uuid . ,chr-uuid)
        (prop . (prop-read))
        (max-len . 1)
        (default-value . [42])
    )
)))

(print (list 'service (ix handles 0) 'value (ix handles 1)))
